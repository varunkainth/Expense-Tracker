NODE_ENV=development
HOST=0.0.0.0
PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Pairing challenges expire in two minutes. Linked control sessions expire after eight hours.
PAIRING_TTL_SECONDS=120
LINKED_TTL_SECONDS=28800
PRESENCE_TTL_SECONDS=45
MAX_PAIRING_SESSIONS=1000

# Production: serve the built website from the same origin as the API.
# FRONTEND_DIST=../frontend/dist
# WEB_ORIGIN defaults to RENDER_EXTERNAL_URL on Render.
# TRUST_PROXY_HOPS=1 only behind Render's edge proxy (default 0).
