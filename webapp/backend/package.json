{
  "name": "@expense-tracker/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HOST=0.0.0.0 bun --watch src/server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "build": "bun build src/server.ts --target=node --outdir=dist --external fastify --external @fastify/cors --external zod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expense-tracker/shared": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/bun": "^1.3.0"
  }
}
