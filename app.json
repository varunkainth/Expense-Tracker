{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense_tracker",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon-v2.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/app-icon-v2.png",
      "bundleIdentifier": "com.expensetracker.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.expensetracker.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#292266",
        "foregroundImage": "./assets/branding/app-icon-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/app-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/app-icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#292266"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Expense Tracker to use Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Expense Tracker to select receipt images.",
          "cameraPermission": "Allow Expense Tracker to take receipt photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "@config-plugins/react-native-blob-util"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7fbaa5f-4437-4a14-88c0-6bf9b395887e"
      }
    }
  }
}
